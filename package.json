{
  "name": "best-classmates",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "node scripts/prisma-cli.mjs generate && node scripts/trim-prisma-runtime.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "node scripts/prisma-cli.mjs generate && node scripts/trim-prisma-runtime.mjs && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:visual": "node scripts/visual-smoke.mjs",
    "prisma:generate": "node scripts/prisma-cli.mjs generate && node scripts/trim-prisma-runtime.mjs",
    "prisma:validate": "node scripts/prisma-cli.mjs validate",
    "db:studio": "node scripts/prisma-cli.mjs studio",
    "db:migrate": "node scripts/prisma-cli.mjs migrate deploy",
    "db:migrate:dev": "node scripts/prisma-cli.mjs migrate dev",
    "db:baseline": "node scripts/prisma-cli.mjs migrate resolve --applied 20261006010000_mysql_initial",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "admin:create": "tsx scripts/create-admin.ts",
    "cloud:inspect": "tsx scripts/cloud-inspect.ts",
    "cloud:blob": "tsx scripts/cloud-blob-verify.ts",
    "cloud:initialize": "tsx scripts/cloud-initialize.ts",
    "test:cloud": "tsx scripts/cloud-live-test.ts"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.27.0",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "6.19.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.8",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
