# 留空时启用只读演示模式。真实凭据只放 .env.local 或部署平台 Secret。
DATABASE_URL=
DIRECT_URL=
# Azure MySQL 示例（密码中的 @ 编码为 %40）：
# mysql://USER:ENCODED_PASSWORD@SERVER.mysql.database.azure.com:3306/best_classmates?sslaccept=strict
APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# 完整 Azure Connection String，仅服务端使用，不能加 NEXT_PUBLIC_。
AZURE_STORAGE_CONNECTION_STRING=
# 示例格式：DefaultEndpointsProtocol=https;AccountName=ACCOUNT;AccountKey=BASE64_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=classbbs

# 仅供本地 Docker MySQL 使用，连接 Azure 时无需设置。
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
